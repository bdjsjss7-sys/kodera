# Copy to .env.local and replace with your own HTTPS endpoint.
# Never commit real credentials or tokens.
# The endpoint must accept JSON POST and respond with a 2xx status.
# If unset, /api/contact returns HTTP 503 and the form shows an error.
KODERA_LEADS_WEBHOOK_URL=
# Optional: passed to the endpoint as Authorization: Bearer <token>
KODERA_LEADS_WEBHOOK_TOKEN=
# Absolute production site origin, e.g. https://your-domain.example
NEXT_PUBLIC_SITE_URL=
